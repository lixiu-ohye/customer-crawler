# ============ 小程序分账系统 - 环境变量配置 ============

# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=promotion_system

# 云购OS API配置（第三方支付托管，规避二清风险）
YUNGOU_API_KEY=your_yungou_api_key
YUNGOU_SECRET=your_yungou_secret
PLATFORM_ACCOUNT=your_platform_account

# 服务器配置
PORT=3000
NODE_ENV=production
